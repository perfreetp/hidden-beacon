    "bench": "node tools/run-ts.mjs tests/bench.ts"
  },
  "dependencies": {
    "d3-contour": "^4.0.3",
    "d3-drag": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "d3-zoom": "^3.0.1",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.2",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "typescript": "5.9",
    "vite": "^7.3.8"
  }

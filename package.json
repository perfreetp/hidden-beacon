{
  "name": "zika-sdf-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Preschool literacy card studio — distance-field rendered Chinese characters and shapes",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
